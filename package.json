{
  "name": "autodroid-api",
  "author": "luizfelipelaviola <luiz@laviola.dev>",
  "version": "0.8.5",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "v22.17.1"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace autodroid-api run dev",
    "dev:server": "yarn workspace autodroid-api run dev:server",
    "dev:server:debug": "yarn workspace autodroid-api run dev:server:debug",
    "start:dev": "yarn workspace autodroid-api run start:dev",
    "start:staging": "yarn workspace autodroid-api run start:staging",
    "start:prod": "yarn workspace autodroid-api run start:prod",
    "lint": "yarn workspaces run lint",
    "prisma:generate": "yarn workspace autodroid-api run prisma:generate",
    "prisma:dev": "yarn workspace autodroid-api run prisma:dev",
    "prisma:prod": "yarn workspace autodroid-api run prisma:prod",
    "test": "yarn workspaces run test",
    "build": "yarn workspace autodroid-api run build",
    "changelog": "commit-and-tag-version --skip.bump --skip.commit --skip.tag -i ./docs/CHANGELOG.md",
    "prepare": "husky",
    "cli": "yarn workspace autodroid-cli run dev",
    "mcp": "yarn workspace autodroid-mcp run dev"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "commit-and-tag-version": "^12.5.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "npm-run-all": "^4.1.5"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
